# ==============================================================================
# QYRO Medical AI - Production-Safe Research Repository Gitignore
# ==============================================================================

# Ignore all datasets, images, and annotations
datasets/
data/
annotation_batches/
annotation_exports/
*.zip
*.tar.gz
*.tar
*.tgz
*.rar
*.7z

# Ignore model weights and execution checkpoints
*.pt
*.pth
*.onnx
*.engine
*.trt
yolov8n.pt
yolov8s.pt
yolo26n.pt
weights/
checkpoints/
!models/production/qyro_acne_v1_best.pt

# Ignore experiment outputs, logs, and TensorBoard directories
runs/
experiments/
logs/
*.log

# Ignore local caches and internal databases
cache/
.cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
sqlite/
*.db
*.sqlite

# Ignore Python virtual environments
venv/
.venv/
env/
ENV/

# Ignore local configuration files and environment keys
.env
.env.local
.env.*.local
configs/local_*.yaml

# Ignore exports and temporary reports
exports/
scratch/
reports/archive/
reports/temporary_*.md
reports/temporary_*.json
test.png

# Ignore IDE and OS configurations
.vscode/
.idea/
.project
.settings/
.DS_Store
Thumbs.db
desktop.ini
