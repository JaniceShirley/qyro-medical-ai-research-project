# Copy to qyro_app/.env (git-ignored) and fill in ONE key. Never commit real keys.
# Groq: https://console.groq.com/keys    Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider (groq | gemini | none) and/or a model
# QYRO_LLM_PROVIDER=groq
# QYRO_LLM_MODEL=openai/gpt-oss-120b
